# Copy to .env and fill in. `.env` is git-ignored and loaded automatically by app.py.
#
# Vapi Dashboard -> API Keys -> Private API Key
VAPI_API_KEY=your-vapi-private-key-here

# Vapi Dashboard -> Phone Numbers -> the UUID of your claimed number (NOT the +1 number)
#   curl -s -H "Authorization: Bearer $VAPI_API_KEY" https://api.vapi.ai/phone-number
VAPI_PHONE_NUMBER_ID=your-vapi-phone-number-id-uuid

# Optional: your own cell in E.164 format. Live calls go here instead of the
# synthetic prospect's number. Equivalent to passing --test-phone.
VAPI_TEST_PHONE=+1XXXXXXXXXX
